<Window x:Class="EDActivityOverlay.Windows.CompositeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EDActivityOverlay.UserControls"
        Title="EDAO | Composite"
        Width="1" Height="1"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Canvas x:Name="OverlayCanvas"
            Background="Transparent"
            ClipToBounds="True">
        <ContentControl x:Name="MainPanelHost" />
        <controls:ShipStatusPanelControl x:Name="ShipStatusPanel" />
        <controls:NotificationPanelControl x:Name="NotificationPanel" />
        <controls:PinnedRoutePanelControl x:Name="PinnedRoutePanel" />
    </Canvas>
</Window>
