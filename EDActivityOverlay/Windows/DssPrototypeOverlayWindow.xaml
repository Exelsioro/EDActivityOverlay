<Window x:Class="EDActivityOverlay.Windows.DssPrototypeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize">
    <Canvas x:Name="OverlayCanvas"
            IsHitTestVisible="False">
        <Line x:Name="ReticleHorizontal"
              Stroke="#AA00FF88"
              StrokeThickness="1"
              X1="0" X2="0" Y1="0" Y2="0"/>
        <Line x:Name="ReticleVertical"
              Stroke="#AA00FF88"
              StrokeThickness="1"
              X1="0" X2="0" Y1="0" Y2="0"/>

        <Line x:Name="CenterGuide"
              Stroke="#9900FF88"
              StrokeThickness="1"
              StrokeDashArray="4,4"
              Visibility="Collapsed"/>

        <Ellipse x:Name="DetectedBodyCenter"
                 Width="16"
                 Height="16"
                 Stroke="#FF00FF88"
                 StrokeThickness="2"
                 Fill="#2200FF88"
                 Visibility="Collapsed"/>

        <Ellipse x:Name="DetectedHorizonCircle"
                 Stroke="#CC00CCFF"
                 StrokeThickness="2"
                 StrokeDashArray="7,5"
                 Visibility="Collapsed"/>

        <Line x:Name="DetectedHorizonDash"
              Stroke="#FFFF4DFF"
              StrokeThickness="3"
              Visibility="Collapsed"/>


        <Border x:Name="ReadinessPanel"
                Visibility="Collapsed"
                Canvas.Top="18"
                Width="460"
                Padding="12,8"
                CornerRadius="4"
                BorderThickness="1.5"
                BorderBrush="#AA66BFFF"
                Background="#D0101010">
            <StackPanel>
                <TextBlock x:Name="ReadinessTitle"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#FFFFFFFF"
                           TextAlignment="Center"
                           Text="{DynamicResource Loc_DSS_CALIBRATING}"/>
                <TextBlock x:Name="ReadinessDetail"
                           Margin="0,3,0,0"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#FFD8E8F2"
                           TextAlignment="Center"
                           Text="{DynamicResource Loc_DSS_CALIBRATE_HORIZON}"/>
            </StackPanel>
        </Border>

        <Border x:Name="DebugPanel"
                Visibility="Collapsed"
                Canvas.Left="18"
                Canvas.Top="18"
                Padding="9,6"
                CornerRadius="3"
                BorderThickness="1"
                BorderBrush="#6600FF88"
                Background="#B0101010">
            <TextBlock x:Name="DebugText"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="#FFE8FFF4"
                       Text="DSS"/>
        </Border>
    </Canvas>
</Window>
