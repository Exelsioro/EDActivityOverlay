<Window x:Class="EDActivityOverlay.Windows.WaitingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_ED_Trade_Overlay}" Height="340" Width="571"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource PrimaryBackgroundColorBrush}"
        Foreground="{DynamicResource PrimaryTextColorBrush}">
    <Border Margin="12" Padding="22" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_ED_TRADE_OVERLAY}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                    <TextBlock Text="{DynamicResource Loc_ROUTES_LOCAL_JOURNAL}"
                               Foreground="{DynamicResource MutedTextColorBrush}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
                <Grid Grid.Column="1" Width="28" Height="28">
                    <Ellipse Stroke="{DynamicResource MutedTextColorBrush}" StrokeThickness="2"/>
                    <Path Stroke="{DynamicResource AccentColorBrush}" StrokeThickness="2"
                          Data="M 14,1 A 13,13 0 0 1 27,14" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform x:Name="SpinnerRotation"/></Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="{DynamicResource Loc_Welcome_commander}" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                <Border Margin="30,18,30,0" Padding="12"
                        Background="{DynamicResource SecondaryBackgroundColorBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_QUICK_ACCESS}" Foreground="{DynamicResource AccentColorBrush}" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="{DynamicResource Loc_Ctrl_5_visibility_Ctrl_6_interaction_Ctrl_7_unpin}"
                                   Foreground="{DynamicResource MutedTextColorBrush}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsButton" Grid.Column="0" Content="{DynamicResource Loc_SETTINGS}" Width="100" Height="34"
                        Style="{DynamicResource InvertHoverButtonStyle}"
                        Click="SettingsButton_Click"/>
                <Button x:Name="StartOverlayButton" Grid.Column="2" Content="{DynamicResource Loc_START}" Width="125" Height="34"
                        Style="{DynamicResource InvertHoverButtonStyle}" FontWeight="Bold"
                        Click="StartOverlayButton_Click"/>
                <Button x:Name="CloseButton" Grid.Column="4" Content="{DynamicResource Loc_EXIT}" Width="70" Height="34"
                        Style="{DynamicResource InvertHoverButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
