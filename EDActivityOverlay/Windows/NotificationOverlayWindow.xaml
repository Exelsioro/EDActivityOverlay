<Window x:Class="EDActivityOverlay.Windows.NotificationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" MaxHeight="310"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" ResizeMode="NoResize">
    <ItemsControl x:Name="NotificationItems" ItemsSource="{Binding Notifications}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Padding="12,9">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Margin" Value="3,0,3,7"/>
                            <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundColorBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChromeStyle}" Value="Minimal">
                                    <Setter Property="Margin" Value="0,0,0,7"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Severity}" Margin="12,0,0,0"
                                       FontWeight="Bold" FontSize="9"
                                       Foreground="{DynamicResource AccentColorBrush}"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Message}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
