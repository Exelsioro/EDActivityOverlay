<Window x:Class="EDActivityOverlay.Windows.EngineeringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_Engineering_assistant}"
        Width="1180" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackgroundColorBrush}"
        Foreground="{DynamicResource PrimaryTextColorBrush}">
    <Grid>
        <Border x:Name="EngineeringWidgetPanel" Visibility="Collapsed"
                Style="{DynamicResource WindowBorderStyle}" Margin="3" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_ENGINEERING_ASSISTANT}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                        <TextBlock x:Name="WidgetInteractionHint"
                                   Text="{DynamicResource Loc_CTRL_6_INTERACT}"
                                   FontSize="9" Foreground="{DynamicResource MutedTextColorBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Width="28" Height="28"
                            Click="OverlayCloseButton_Click"/>
                </Grid>

                <TextBlock x:Name="WidgetSummaryText" Grid.Row="1" Margin="0,10,0,8"
                           Foreground="{DynamicResource SecondaryTextColorBrush}"
                           FontWeight="SemiBold"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc_Widget_missing_materials}"
                               Foreground="{DynamicResource AccentColorBrush}"
                               FontSize="10" FontWeight="Bold"/>
                    <ScrollViewer Grid.Row="1" Margin="0,5,0,0" MaxHeight="170"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="WidgetRequirementsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="6,4"
                                            Background="{DynamicResource HighlightBackgroundBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Material}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextColorBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Progress}" FontSize="9"
                                                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                <Button Content="{DynamicResource Loc_COPY_SYSTEM_SHORT}" Padding="6,2" Margin="0,0,4,0"
                                                        IsEnabled="{Binding CanCopySystem}" CommandParameter="{Binding}"
                                                        Click="CopyWidgetSystem_Click"/>
                                                <Button Content="{DynamicResource Loc_HELP}" Padding="7,2"
                                                        IsEnabled="{Binding CanOpenHelp}" CommandParameter="{Binding}"
                                                        Click="OpenWidgetHelp_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="WidgetDestinationText" Grid.Row="2" Margin="0,7,0,0"
                               Foreground="{DynamicResource MutedTextColorBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Button Content="{DynamicResource Loc_Open_full_engineering_assistant}"
                            Padding="12,4" Style="{DynamicResource InvertHoverButtonStyle}"
                            Click="OpenFullAssistantButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="EngineeringWidgetHelpPanel" Visibility="Collapsed"
                Style="{DynamicResource WindowBorderStyle}" Margin="3" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="WidgetHelpTitle" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentColorBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{DynamicResource Loc_All_known_acquisition_methods}" FontSize="9"
                                   Foreground="{DynamicResource MutedTextColorBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Width="28" Height="28"
                            Click="OverlayCloseButton_Click"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,8">
                    <Button Content="{DynamicResource Loc_BACK_TO_MATERIALS}" Padding="9,3"
                            Click="CloseWidgetHelp_Click"/>
                    <Button x:Name="WidgetMaterialWikiButton" Content="{DynamicResource Loc_MATERIAL_WIKI}"
                            Margin="6,0,0,0" Padding="9,3" Click="OpenMaterialWiki_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="WidgetHelpOptions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,7" Padding="8"
                                        Background="{DynamicResource HighlightBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                        <TextBlock Text="{Binding Instructions}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                                        <TextBlock Text="{Binding Destination}" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource AccentColorBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="{DynamicResource Loc_COPY_SYSTEM}" Margin="0,0,5,0" Padding="7,3"
                                                    IsEnabled="{Binding CanCopySystem}" CommandParameter="{Binding}"
                                                    Click="CopyHelpSystem_Click"/>
                                            <Button Content="{DynamicResource Loc_OPEN_SOURCE}" Padding="7,3"
                                                    IsEnabled="{Binding CanOpenUrl}" CommandParameter="{Binding}"
                                                    Click="OpenHelpSource_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

    <Grid x:Name="FullAssistantPanel" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource Loc_ENGINEERING_ASSISTANT}" FontSize="23" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                <TextBlock Text="{DynamicResource Loc_JOURNAL_BLUEPRINT_LIST_ACQUISITION_ADVISOR}"
                           FontSize="10" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextColorBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Border Padding="12,7" BorderBrush="{DynamicResource BorderColorBrush}"
                    BorderThickness="1" Background="{DynamicResource HighlightBackgroundBrush}">
                <StackPanel>
                    <TextBlock x:Name="CommanderText" Text="CMDR —" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="SummaryText" Text="{DynamicResource Loc_Waiting_for_journal_data}"
                               Foreground="{DynamicResource SecondaryTextColorBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Button x:Name="OverlayCloseButton" Content="{DynamicResource Loc_CLOSE}" Margin="8,0,0,0" Padding="12,7"
                    Visibility="Collapsed" Click="OverlayCloseButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,12" BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1,0,0,0" Background="{DynamicResource SecondaryBackgroundColorBrush}"
                Padding="12,8">
                    <TextBlock Text="{DynamicResource Loc_Quantities_are_read_from_Materials_json_Backpack_json_and_ShipLocker_json_The_plan_shows_e}"
                       Foreground="{DynamicResource SecondaryTextColorBrush}" TextWrapping="Wrap"/>
        </Border>

        <TabControl x:Name="EngineeringTabs" Grid.Row="2" Style="{DynamicResource EliteTabControlStyle}">
            <TabItem Header="{DynamicResource Loc_MATERIALS}" Style="{DynamicResource EliteTabItemStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InventorySearchBox" Style="{DynamicResource TextBoxStyle}"
                                 ToolTip="{DynamicResource Loc_Search_materials}" TextChanged="InventoryFilterChanged"/>
                        <ComboBox x:Name="CategoryFilter" Grid.Column="2" Style="{DynamicResource ComboBoxStyle}"
                                  DisplayMemberPath="Label"
                                  SelectionChanged="InventoryFilterChanged"/>
                    </Grid>
                    <DataGrid x:Name="InventoryGrid" Grid.Row="1" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc_MATERIAL}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_CATEGORY}" Binding="{Binding CategoryName}" Width="160"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_AVAILABLE}" Binding="{Binding Count}" Width="110"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_UPDATED}" Binding="{Binding UpdatedUtc, StringFormat={}{0:HH:mm:ss}}" Width="110"/>
                            <DataGridTemplateColumn Header="{DynamicResource Loc_ACTIONS}" Width="215">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding TrackingLabel}" Padding="7,3" Margin="0,0,5,0"
                                                    CommandParameter="{Binding}" Click="ToggleMaterialTracking_Click"/>
                                            <Button Content="{DynamicResource Loc_HELP}" Padding="8,3"
                                                    CommandParameter="{Binding}" Click="OpenInventoryHelp_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{DynamicResource Loc_TRACKING_HINT}" Margin="0,7,0,0"
                               Foreground="{DynamicResource MutedTextColorBrush}" FontSize="10"/>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc_TRACKED}" Style="{DynamicResource EliteTabItemStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc_TRACKED_MATERIALS_HINT}" Margin="0,0,0,8"
                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                    <DataGrid x:Name="TrackedMaterialsGrid" Grid.Row="1" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc_MATERIAL}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_CATEGORY}" Binding="{Binding CategoryName}" Width="150"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_AVAILABLE}" Binding="{Binding Available}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_TARGET}" Binding="{Binding Target}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_MISSING}" Binding="{Binding Missing}" Width="100"/>
                            <DataGridTemplateColumn Header="{DynamicResource Loc_ACTIONS}" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Loc_HELP}" Padding="8,3" Margin="0,0,5,0"
                                                    CommandParameter="{Binding}" Click="OpenTrackedHelp_Click"/>
                                            <Button Content="{DynamicResource Loc_UNTRACK}" Padding="8,3"
                                                    CommandParameter="{Binding}" Click="UntrackMaterial_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc_BLUEPRINTS_AND_PLAN}" Style="{DynamicResource EliteTabItemStyle}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Loc_ADD_BLUEPRINT}" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}"/>
                        <Grid Grid.Row="1" Margin="0,8,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="RecipeSearchBox" Style="{DynamicResource TextBoxStyle}"
                                     ToolTip="{DynamicResource Loc_Filter_by_module_or_modification}" TextChanged="RecipeSearchChanged"/>
                            <ComboBox x:Name="RecipeCombo" Grid.Row="1" Margin="0,5,0,0"
                                      DisplayMemberPath="DisplayName" Style="{DynamicResource ComboBoxStyle}"/>
                        </Grid>
                        <DataGrid x:Name="WishlistGrid" Grid.Row="2" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc_PLANNED}" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_APPLICATIONS}" Binding="{Binding CraftCount}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc_QTY}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="CraftCountBox" Grid.Column="1" Text="1" Style="{DynamicResource TextBoxStyle}"/>
                            <Button Grid.Column="3" Content="{DynamicResource Loc_ADD_TO_PLAN}" Height="34"
                                    Style="{DynamicResource InvertHoverButtonStyle}" Click="AddRecipe_Click"/>
                            <Button Grid.Column="4" Content="{DynamicResource Loc_REMOVE}" Width="90" Height="34" Margin="8,0,0,0"
                                    Style="{DynamicResource InvertHoverButtonStyle}" Click="RemoveWishlist_Click"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Loc_REQUIRED_MATERIALS}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentColorBrush}" Margin="0,0,0,8"/>
                        <DataGrid x:Name="RequirementsGrid" Grid.Row="1" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc_MATERIAL}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_TYPE}" Binding="{Binding CategoryName}" Width="120"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_HAVE_NEED}" Binding="{Binding ProgressText}" Width="120"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_MISSING}" Binding="{Binding Missing}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc_WHERE_TO_FIND}" Style="{DynamicResource EliteTabItemStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc_MISSING_MATERIALS_RECOMMENDED_SOURCES}" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColorBrush}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="AdviceGrid" Grid.Row="1" AlternationCount="2" MouseDoubleClick="AdviceGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc_MATERIAL}" Binding="{Binding Material}" Width="180"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_MISSING}" Binding="{Binding Missing}" Width="80"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_SOURCE}" Binding="{Binding Source}" Width="160"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_WHERE_TO_GO}" Binding="{Binding Destination}" Width="200"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_HOW_TO_GET}" Binding="{Binding Instructions}" Width="*"/>
                            <DataGridTemplateColumn Header="{DynamicResource Loc_ACTIONS}" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Loc_COPY_SYSTEM_SHORT}" Margin="0,0,5,0" Padding="7,3"
                                                    IsEnabled="{Binding CanCopySystem}" CommandParameter="{Binding}"
                                                    Click="CopyAdviceSystem_Click"/>
                                            <Button Content="{DynamicResource Loc_HELP}" Padding="9,3"
                                                    CommandParameter="{Binding}" Click="OpenAdviceHelp_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="AdviceHelpPanel" Grid.Row="2" Visibility="Collapsed"
                            Margin="0,10,0,0" Padding="12"
                            BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AdviceHelpTitle" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentColorBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="AdviceMaterialWikiButton" Content="{DynamicResource Loc_MATERIAL_WIKI}"
                                            Padding="9,3" Margin="0,0,6,0" Click="OpenMaterialWiki_Click"/>
                                    <Button Content="{DynamicResource Loc_CLOSE_HELP}" Padding="9,3"
                                            Click="CloseAdviceHelp_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Loc_All_known_acquisition_methods}"
                                       Margin="0,4,0,8" Foreground="{DynamicResource MutedTextColorBrush}"/>
                            <ScrollViewer Grid.Row="2" MaxHeight="245" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AdviceHelpOptions">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,7" Padding="9"
                                                    Background="{DynamicResource HighlightBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                                    <TextBlock Text="{Binding Instructions}" Margin="0,3,0,0"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                                                    <TextBlock Text="{Binding Destination}" Margin="0,4,0,0"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentColorBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Button Content="{DynamicResource Loc_COPY_SYSTEM}" Margin="0,0,6,0" Padding="8,3"
                                                                IsEnabled="{Binding CanCopySystem}" CommandParameter="{Binding}"
                                                                Click="CopyHelpSystem_Click"/>
                                                        <Button Content="{DynamicResource Loc_OPEN_SOURCE}" Padding="8,3"
                                                                IsEnabled="{Binding CanOpenUrl}" CommandParameter="{Binding}"
                                                                Click="OpenHelpSource_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc_ENGINEERS}" Style="{DynamicResource EliteTabItemStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Loc_Engineer_directory_hint}" Margin="0,0,0,8"
                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="EngineersGrid" AlternationCount="2" SelectionChanged="EngineersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc_ENGINEER}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_TYPE}" Binding="{Binding EngineerType}" Width="85"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_LOCATION}" Binding="{Binding SystemName}" Width="130"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_STATUS}" Binding="{Binding CurrentStatus}" Width="125"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="2" Padding="14" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"
                                Background="{DynamicResource SecondaryBackgroundColorBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="EngineerNameText" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBlock x:Name="EngineerLocationText" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Loc_CURRENT_STAGE}" Margin="0,14,0,3" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBlock x:Name="EngineerCurrentStageText" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource Loc_DISCOVERY_STAGE}" Margin="0,14,0,3" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBlock x:Name="EngineerDiscoveryText" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource Loc_MEETING_STAGE}" Margin="0,12,0,3" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBlock x:Name="EngineerMeetingText" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource Loc_UNLOCK_STAGE}" Margin="0,12,0,3" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBlock x:Name="EngineerUnlockText" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="{DynamicResource Loc_COPY_SYSTEM}" Padding="10,4" Margin="0,0,7,0"
                                                Click="CopyEngineerSystem_Click"/>
                                        <Button Content="{DynamicResource Loc_OPEN_WIKI}" Padding="10,4"
                                                Click="OpenEngineerWiki_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Loc_AVAILABLE_BLUEPRINTS}" Margin="0,18,0,5" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                    <ComboBox x:Name="EngineerBlueprintCombo" DisplayMemberPath="DisplayName"
                                              Style="{DynamicResource ComboBoxStyle}"
                                              SelectionChanged="EngineerBlueprint_SelectionChanged"/>
                                    <Grid Margin="0,7,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Loc_GRADE}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="EngineerGradeCombo" Grid.Column="1" DisplayMemberPath="Label"
                                                  Style="{DynamicResource ComboBoxStyle}"
                                                  SelectionChanged="EngineerGrade_SelectionChanged"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_SELECTED_GRADE_MATERIALS}" FontWeight="Bold"/>
                                            <DataGrid x:Name="EngineerGradeMaterialsGrid" Height="145" Margin="0,5,0,0" AlternationCount="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource Loc_MATERIAL}" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="{DynamicResource Loc_QTY}" Binding="{Binding Count}" Width="55"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Content="{DynamicResource Loc_PIN_SELECTED_GRADE}" Margin="0,6,0,0"
                                                    Click="PinEngineerGrade_Click"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Loc_FULL_GRADE_PATH_MATERIALS}" FontWeight="Bold"/>
                                            <DataGrid x:Name="EngineerPathMaterialsGrid" Height="145" Margin="0,5,0,0" AlternationCount="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource Loc_MATERIAL}" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="{DynamicResource Loc_QTY}" Binding="{Binding Count}" Width="55"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Content="{DynamicResource Loc_PIN_FULL_PATH}" Margin="0,6,0,0"
                                                    Click="PinEngineerPath_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="EngineerBlueprintUnavailableText"
                                               Text="{DynamicResource Loc_ENGINEER_BLUEPRINTS_UNAVAILABLE}"
                                               Margin="0,7,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextColorBrush}" Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CatalogStatusText" Text="{DynamicResource Loc_Blueprint_catalog_built_in_data}"
                       Foreground="{DynamicResource MutedTextColorBrush}" VerticalAlignment="Center"/>
            <Button x:Name="RefreshCatalogButton" Grid.Column="1" Content="{DynamicResource Loc_REFRESH_CATALOG}" Width="170" Height="32"
                    Style="{DynamicResource InvertHoverButtonStyle}" Click="RefreshCatalog_Click"/>
        </Grid>
    </Grid>
    </Grid>
</Window>
