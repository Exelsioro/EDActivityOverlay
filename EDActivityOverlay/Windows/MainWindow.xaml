<Window x:Class="EDActivityOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ED Activity Overlay" Height="166" Width="235"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border x:Name="OverlayFrame" Margin="0" Padding="10,7" BorderThickness="1"
            BorderBrush="{DynamicResource BorderColorBrush}"
            Background="{DynamicResource PrimaryBackgroundColorBrush}">
        <Grid>
            <Grid x:Name="ExpandedControlContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource Loc_ED_ASSISTANT}"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>

                    <Border Grid.Column="1"
                            Background="{DynamicResource HighlightBackgroundBrush}"
                            Padding="6,1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="InteractionStatusBadge"
                                   Text="{DynamicResource Loc_PASSIVE}"
                                   Foreground="{DynamicResource AccentColorBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>

                    <Button Grid.Column="2"
                            x:Name="CollapseMainOverlayButton"
                            Content="−"
                            Width="24"
                            Height="22"
                            Margin="5,0,0,0"
                            Padding="0"
                            FontSize="12"
                            ToolTip="{DynamicResource Loc_COLLAPSE}"
                            Click="CollapseMainOverlayButton_Click"/>
                </Grid>

                <ComboBox x:Name="ActivitySelector"
                          Grid.Row="1"
                          Height="27"
                          FontSize="10"
                          Margin="0,7,0,0"
                          HorizontalAlignment="Stretch"
                          Style="{DynamicResource ComboBoxStyle}"
                          DisplayMemberPath="Label"
                          SelectionChanged="ActivitySelector_SelectionChanged"/>

                <Button x:Name="ActivitySettingsButton"
                        Grid.Row="2"
                        Content="{DynamicResource Loc_SETTINGS_2}"
                        Height="27"
                        Margin="0,6,0,0"
                        FontSize="9"
                        Click="ActivitySettingsButton_Click"/>

                <TextBlock x:Name="InteractionHintText"
                           Grid.Row="3"
                           Text="{DynamicResource Loc_Ctrl_5_visibility_Ctrl_6_cursor_Ctrl_1_4_section}"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextColorBrush}"
                           FontSize="9"
                           TextWrapping="Wrap"/>
            </Grid>

            <Grid x:Name="CollapsedControlContent"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource HighlightBackgroundBrush}"
                        Padding="6,1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="CollapsedInteractionStatusBadge"
                               Text="{DynamicResource Loc_PASSIVE}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AccentColorBrush}"
                               FontSize="9"
                               FontWeight="Bold"/>
                </Border>

                <Button Grid.Column="1"
                        Content="⚙"
                        Width="26"
                        Height="22"
                        Margin="5,0,0,0"
                        Padding="0"
                        FontSize="12"
                        ToolTip="{DynamicResource Loc_SETTINGS_2}"
                        Click="ActivitySettingsButton_Click"/>

                <Button Grid.Column="2"
                        x:Name="ExpandMainOverlayButton"
                        Content="□"
                        Width="26"
                        Height="22"
                        Margin="4,0,0,0"
                        Padding="0"
                        FontSize="12"
                        ToolTip="{DynamicResource Loc_EXPAND}"
                        Click="ExpandMainOverlayButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
