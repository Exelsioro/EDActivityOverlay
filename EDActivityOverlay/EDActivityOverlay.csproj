<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>EDActivityOverlay</RootNamespace>
    <AssemblyName>EDActivityOverlay</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.3.0-beta.1</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>ED Activity Overlay</Product>
    <Company>Exelsioro</Company>
    <Authors>Exelsioro and contributors</Authors>
    <Description>Activity-oriented companion overlay for Elite Dangerous.</Description>
    <Copyright>Copyright (c) 2025-2026 Exelsioro</Copyright>
    <RepositoryUrl>https://github.com/Exelsioro/EDActivityOverlay</RepositoryUrl>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
    <SignAssembly>True</SignAssembly>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <PackageIcon>Resources\app.ico</PackageIcon>
    <!-- WPF's package-aware markup pass creates a randomly named *_wpftmp.csproj
         beside this project. C# Dev Kit discovers that transient file as a real
         project and retains a failed entry after WPF deletes it. This project
         does not use markup-time source generators, so the stable legacy pass
         is both sufficient and invisible to project discovery. -->
    <IncludePackageReferencesDuringMarkupCompilation>false</IncludePackageReferencesDuringMarkupCompilation>
    <!-- Keep generated WPF sources out of implicit Compile globs in the
         temporary markup project as well as in normal design-time builds. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**\*;$(MSBuildProjectDirectory)\bin\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Logger\Logger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Themes\*.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="Resources\ExobiologyBioforge\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Documentation\X52_CONTROL_CHEATSHEET_RU.md" Link="Documentation\X52_CONTROL_CHEATSHEET_RU.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Documentation\THIRD_PARTY.md" Link="THIRD_PARTY.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Documentation\ThirdPartyLicenses\**\*" Link="ThirdPartyLicenses\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
