<UserControl x:Class="EDActivityOverlay.UserControls.ExplorationWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="CompactExplorationPanel"
                Padding="14,11"
                Background="{DynamicResource PrimaryBackgroundColorBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="DragHandle"
                      MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TitleText"
                                   Text="{DynamicResource Loc_EXPLORATION}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                        <TextBlock x:Name="ModuleStatusText"
                                   Margin="0,2,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource AccentColorBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{DynamicResource Loc_CTRL_6_INTERACT}"
                               FontSize="9"
                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,9,0,7"
                        Padding="9,7"
                        Background="{DynamicResource HighlightBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentColorBrush}"
                        BorderThickness="2,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CompactModeText"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColorBrush}"/>
                            <TextBlock x:Name="CompactContextTitleText"
                                       Margin="0,2,0,0"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="CompactQueueCountText"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="DestinationVisitStatusText"
                           Grid.Row="2"
                           Margin="9,0,9,7"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           FontSize="9"
                           Foreground="{DynamicResource AccentColorBrush}"/>

                <Grid Grid.Row="3">
                    <Border x:Name="SystemContextPanel"
                            Padding="9,7"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="1,0,0,0">
                        <StackPanel>
                            <ItemsControl x:Name="CompactTargetsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Margin="0,0,0,4"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="CompactEmptyTargetsText"
                                       Visibility="Collapsed"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BodyContextPanel"
                            Visibility="Collapsed"
                            Padding="9,7"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            BorderThickness="1,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="BodyStatusText"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                            <TextBlock x:Name="BodyObjectiveText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                            <TextBlock x:Name="BodyMissingText"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentColorBrush}"/>
                            <TextBlock x:Name="BodyMetaText"
                                       Margin="0,4,0,0"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ExobioContextPanel"
                            Visibility="Collapsed"
                            Padding="9,7"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            BorderThickness="1,0,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="50" Height="50">
                                    <Ellipse Stroke="{DynamicResource BorderColorBrush}" StrokeThickness="1"/>
                                    <Ellipse Width="30" Height="30"
                                             Stroke="{DynamicResource MutedTextColorBrush}"
                                             StrokeThickness="1"
                                             StrokeDashArray="2,2"/>
                                    <Ellipse Width="4" Height="4"
                                             Fill="{DynamicResource PrimaryTextColorBrush}"/>
                                    <Path Data="M 25,4 L 20,15 L 25,12 L 30,15 Z"
                                          Fill="{DynamicResource AccentColorBrush}"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="SurfaceEscapeArrowTransform"
                                                             Angle="0"
                                                             CenterX="25"
                                                             CenterY="25"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <TextBlock x:Name="SurfaceNavigationText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                            </Grid>
                            <TextBlock x:Name="ExobioBodyProgressText"
                                       Margin="0,6,0,0"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Composite/VR keeps the DSS assistance state, but this
                         surface is deliberately journal/catalog-only. It must
                         never consume CV/runtime screen-recognition state. -->
                    <Border x:Name="DssContextPanel"
                            Visibility="Collapsed"
                            Padding="9,7"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            BorderThickness="2,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="112"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_DSS_ASSISTANT}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColorBrush}"/>
                                <TextBlock x:Name="DssBodyText"
                                           Margin="0,2,0,0"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                <TextBlock x:Name="DssTargetText"
                                           Margin="0,6,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                <TextBlock x:Name="DssTargetHintText"
                                           Margin="0,3,0,0"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                                <TextBlock x:Name="DssResultText"
                                           Margin="0,5,0,0"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                                <TextBlock x:Name="DssPlanText"
                                           Margin="0,5,0,0"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentColorBrush}"/>
                            </StackPanel>
                            <Canvas x:Name="DssPlanCanvas"
                                    Grid.Column="1"
                                    Width="108"
                                    Height="96"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="CompactRouteAlertPanel"
                        Grid.Row="4"
                        Margin="0,7,0,0"
                        Visibility="Collapsed"
                        Padding="9,6"
                        Background="{DynamicResource SecondaryBackgroundColorBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="1,0,0,0">
                    <TextBlock x:Name="CompactRouteAlertText"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                </Border>

                <TextBlock x:Name="FooterHintText"
                           Grid.Row="5"
                           Margin="0,7,0,0"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextColorBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
