<UserControl x:Class="EDActivityOverlay.UserControls.MainOverlayPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="235" Height="166"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border x:Name="OverlayFrame"
            Padding="10,7"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderColorBrush}"
            Background="{DynamicResource PrimaryBackgroundColorBrush}">
        <Grid>
            <Grid x:Name="ExpandedControlContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Loc_ED_ASSISTANT}"
                               FontWeight="Bold" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                    <Border Grid.Column="1"
                            Background="{DynamicResource HighlightBackgroundBrush}"
                            Padding="6,1" VerticalAlignment="Center">
                        <TextBlock x:Name="InteractionStatusBadge"
                                   Text="{DynamicResource Loc_PASSIVE}"
                                   Foreground="{DynamicResource AccentColorBrush}"
                                   FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Button Grid.Column="2"
                            Content="−"
                            Width="24" Height="22"
                            Margin="5,0,0,0" Padding="0"
                            ToolTip="{DynamicResource Loc_COLLAPSE}"
                            Click="CollapseButton_Click"/>
                </Grid>

                <ComboBox x:Name="ActivitySelector"
                          Grid.Row="1"
                          Height="27" FontSize="10"
                          Margin="0,7,0,0"
                          HorizontalAlignment="Stretch"
                          Style="{DynamicResource ComboBoxStyle}"
                          DisplayMemberPath="Label"
                          SelectionChanged="ActivitySelector_SelectionChanged"/>

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{DynamicResource Loc_SETTINGS_2}"
                            Height="27" FontSize="9"
                            Click="SettingsButton_Click"/>
                    <Button x:Name="InteractionButton"
                            Grid.Column="1"
                            Content="Ctrl+6"
                            Width="62" Height="27"
                            Margin="6,0,0,0" FontSize="9"
                            Click="InteractionButton_Click"/>
                </Grid>

                <TextBlock x:Name="InteractionHintText"
                           Grid.Row="3"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextColorBrush}"
                           FontSize="9" TextWrapping="Wrap"/>
            </Grid>

            <Grid x:Name="CollapsedControlContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource HighlightBackgroundBrush}"
                        Padding="6,1" VerticalAlignment="Center">
                    <TextBlock x:Name="CollapsedInteractionStatusBadge"
                               Text="{DynamicResource Loc_PASSIVE}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AccentColorBrush}"
                               FontSize="9" FontWeight="Bold"/>
                </Border>
                <Button Grid.Column="1"
                        Content="⚙"
                        Width="26" Height="22"
                        Margin="5,0,0,0" Padding="0"
                        ToolTip="{DynamicResource Loc_SETTINGS_2}"
                        Click="SettingsButton_Click"/>
                <Button Grid.Column="2"
                        Content="□"
                        Width="26" Height="22"
                        Margin="4,0,0,0" Padding="0"
                        ToolTip="{DynamicResource Loc_EXPAND}"
                        Click="ExpandButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
