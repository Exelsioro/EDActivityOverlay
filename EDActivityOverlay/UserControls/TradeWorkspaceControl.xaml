<UserControl x:Class="EDActivityOverlay.UserControls.TradeWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="960" MinHeight="580">
    <Border Padding="16"
            Background="{DynamicResource PrimaryBackgroundColorBrush}"
            BorderBrush="{DynamicResource BorderColorBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header / single drag surface for the whole workspace. -->
            <Grid x:Name="TradeDragHandle"
                  MouseLeftButtonDown="TradeDragHandle_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_TRADE_WORKSPACE_TITLE}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                    <TextBlock x:Name="JournalContextText"
                               Margin="0,3,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="88"
                        Height="34"
                        Content="{DynamicResource Loc_CLOSE}"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Search controls stay in this window; no separate results window. -->
            <Border Grid.Row="1"
                    Margin="0,12,0,8"
                    Padding="11,9"
                    Background="{DynamicResource SecondaryBackgroundColorBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Loc_TRADE_ANCHOR_SYSTEM}"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                        <TextBox x:Name="AnchorSystemTextBox"
                                 Height="28"
                                 Margin="0,3,0,0"
                                 VerticalContentAlignment="Center"
                                 Style="{DynamicResource TextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Loc_TRADE_CARGO_FREE}"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                        <TextBox x:Name="CargoTextBox"
                                 Height="28"
                                 Margin="0,3,0,0"
                                 VerticalContentAlignment="Center"
                                 Style="{DynamicResource TextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{DynamicResource Loc_TRADE_SOURCE_RADIUS}"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                        <ComboBox x:Name="SourceRadiusComboBox"
                                  Height="28"
                                  Margin="0,3,0,0"
                                  Style="{DynamicResource ComboBoxStyle}">
                            <ComboBoxItem Content="10 LY" Tag="10"/>
                            <ComboBoxItem Content="20 LY" Tag="20"/>
                            <ComboBoxItem Content="30 LY" Tag="30"/>
                            <ComboBoxItem Content="40 LY" Tag="40"/>
                            <ComboBoxItem Content="50 LY" Tag="50"/>
                            <ComboBoxItem Content="60 LY" Tag="60"/>
                            <ComboBoxItem Content="80 LY" Tag="80"/>
                            <ComboBoxItem Content="100 LY" Tag="100"/>
                            <ComboBoxItem Content="150 LY" Tag="150"/>
                            <ComboBoxItem Content="200 LY" Tag="200"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="{DynamicResource Loc_TRADE_TARGET_RADIUS}"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                        <ComboBox x:Name="TargetRadiusComboBox"
                                  Height="28"
                                  Margin="0,3,0,0"
                                  Style="{DynamicResource ComboBoxStyle}">
                            <ComboBoxItem Content="10 LY" Tag="10"/>
                            <ComboBoxItem Content="20 LY" Tag="20"/>
                            <ComboBoxItem Content="30 LY" Tag="30"/>
                            <ComboBoxItem Content="40 LY" Tag="40"/>
                            <ComboBoxItem Content="50 LY" Tag="50"/>
                            <ComboBoxItem Content="60 LY" Tag="60"/>
                            <ComboBoxItem Content="80 LY" Tag="80"/>
                            <ComboBoxItem Content="100 LY" Tag="100"/>
                            <ComboBoxItem Content="150 LY" Tag="150"/>
                            <ComboBoxItem Content="200 LY" Tag="200"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                        <TextBlock Text="{DynamicResource Loc_TRADE_MAX_AGE}"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                        <ComboBox x:Name="MaxAgeComboBox"
                                  Height="28"
                                  Margin="0,3,0,0"
                                  Style="{DynamicResource ComboBoxStyle}">
                            <ComboBoxItem Content="8 h" Tag="8"/>
                            <ComboBoxItem Content="16 h" Tag="16"/>
                            <ComboBoxItem Content="1 d" Tag="24"/>
                            <ComboBoxItem Content="2 d" Tag="48"/>
                            <ComboBoxItem Content="3 d" Tag="72"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="10"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                        <CheckBox x:Name="FleetCarriersCheckBox"
                                  Margin="0,0,10,6"
                                  VerticalAlignment="Center"
                                  Content="{DynamicResource Loc_TRADE_INCLUDE_FLEET_CARRIERS}"/>
                        <Button x:Name="SyncJournalButton"
                                Height="28"
                                Padding="10,2"
                                Content="{DynamicResource Loc_TRADE_SYNC_JOURNAL}"
                                Click="SyncJournalButton_Click"/>
                    </StackPanel>

                    <Expander x:Name="AdvancedFiltersExpander"
                              Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="11"
                              Margin="0,10,0,0"
                              Header="{DynamicResource Loc_TRADE_ADVANCED_FILTERS}">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Loc_TRADE_MIN_PAD}"
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                                <ComboBox x:Name="MinPadComboBox"
                                          Height="28"
                                          Margin="0,3,0,0"
                                          Style="{DynamicResource ComboBoxStyle}">
                                    <ComboBoxItem Content="{DynamicResource Loc_TRADE_PAD_ANY}" Tag="1"/>
                                    <ComboBoxItem Content="{DynamicResource Loc_TRADE_PAD_MEDIUM}" Tag="2"/>
                                    <ComboBoxItem Content="{DynamicResource Loc_TRADE_PAD_LARGE}" Tag="3"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Loc_TRADE_MAX_STATION_DISTANCE}"
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                                <ComboBox x:Name="MaxStationDistanceComboBox"
                                          Height="28"
                                          Margin="0,3,0,0"
                                          Style="{DynamicResource ComboBoxStyle}">
                                    <ComboBoxItem Content="{DynamicResource Loc_TRADE_ANY}" Tag="0"/>
                                    <ComboBoxItem Content="100 ls" Tag="100"/>
                                    <ComboBoxItem Content="500 ls" Tag="500"/>
                                    <ComboBoxItem Content="1 000 ls" Tag="1000"/>
                                    <ComboBoxItem Content="2 000 ls" Tag="2000"/>
                                    <ComboBoxItem Content="5 000 ls" Tag="5000"/>
                                    <ComboBoxItem Content="10 000 ls" Tag="10000"/>
                                    <ComboBoxItem Content="25 000 ls" Tag="25000"/>
                                    <ComboBoxItem Content="50 000 ls" Tag="50000"/>
                                    <ComboBoxItem Content="100 000 ls" Tag="100000"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource Loc_TRADE_MIN_SUPPLY}"
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                                <ComboBox x:Name="MinSupplyComboBox"
                                          Height="28"
                                          Margin="0,3,0,0"
                                          Style="{DynamicResource ComboBoxStyle}">
                                    <ComboBoxItem Content="{DynamicResource Loc_TRADE_ANY}" Tag="1"/>
                                    <ComboBoxItem Content="100" Tag="100"/>
                                    <ComboBoxItem Content="500" Tag="500"/>
                                    <ComboBoxItem Content="1 000" Tag="1000"/>
                                    <ComboBoxItem Content="2 500" Tag="2500"/>
                                    <ComboBoxItem Content="5 000" Tag="5000"/>
                                    <ComboBoxItem Content="10 000" Tag="10000"/>
                                    <ComboBoxItem Content="50 000" Tag="50000"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="{DynamicResource Loc_TRADE_MIN_DEMAND}"
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                                <ComboBox x:Name="MinDemandComboBox"
                                          Height="28"
                                          Margin="0,3,0,0"
                                          Style="{DynamicResource ComboBoxStyle}">
                                    <ComboBoxItem Content="{DynamicResource Loc_TRADE_ANY}" Tag="1"/>
                                    <ComboBoxItem Content="100" Tag="100"/>
                                    <ComboBoxItem Content="500" Tag="500"/>
                                    <ComboBoxItem Content="1 000" Tag="1000"/>
                                    <ComboBoxItem Content="2 500" Tag="2500"/>
                                    <ComboBoxItem Content="5 000" Tag="5000"/>
                                    <ComboBoxItem Content="10 000" Tag="10000"/>
                                    <ComboBoxItem Content="50 000" Tag="50000"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SearchButton"
                        Width="170"
                        Height="32"
                        Content="{DynamicResource Loc_SEARCH_ROUTES}"
                        Click="SearchButton_Click"/>
                <TextBlock x:Name="SearchStatusText"
                           Grid.Column="1"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_TRADE_SORT}"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               FontSize="9"
                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                    <ComboBox x:Name="SortComboBox"
                              Width="170"
                              Height="28"
                              Style="{DynamicResource ComboBoxStyle}"
                              SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Loc_TRADE_SORT_PROFIT}" Tag="profit"/>
                        <ComboBoxItem Content="{DynamicResource Loc_TRADE_SORT_PER_TON}" Tag="perton"/>
                        <ComboBoxItem Content="{DynamicResource Loc_TRADE_SORT_DISTANCE}" Tag="distance"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="8"
                        Background="{DynamicResource SecondaryBackgroundColorBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="1">
                    <DataGrid x:Name="RoutesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              SelectionChanged="RoutesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="★" Binding="{Binding HeldMarker}" Width="26"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_TRADE_COMMODITY}" Binding="{Binding Commodity}" Width="1.0*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_TRADE_SOURCE}" Binding="{Binding Source}" Width="1.8*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_TRADE_TARGET}" Binding="{Binding Target}" Width="1.8*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_TRADE_PROFIT_T}" Binding="{Binding ProfitPerTon}" Width="0.9*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_TRADE_PROFIT_TRIP}" Binding="{Binding ProfitPerTrip}" Width="1.05*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_TRADE_LEG_DISTANCE}" Binding="{Binding TradeLegDistance}" Width="0.8*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_TRADE_AGE}" Binding="{Binding Age}" Width="0.7*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Column="2"
                        Padding="13"
                        Background="{DynamicResource SecondaryBackgroundColorBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedCommodityText"
                                       Text="{DynamicResource Loc_TRADE_SELECT_ROUTE}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentColorBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedProfitText"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextColorBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,10,0,10"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_TRADE_SOURCE}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                                <TextBlock x:Name="SelectedSourceText"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                <TextBlock x:Name="SelectedSourceMetaText"
                                           Margin="0,3,0,10"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextColorBrush}"/>

                                <TextBlock Text="{DynamicResource Loc_TRADE_TARGET}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                                <TextBlock x:Name="SelectedTargetText"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                <TextBlock x:Name="SelectedTargetMetaText"
                                           Margin="0,3,0,10"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextColorBrush}"/>

                                <Border Padding="9,7"
                                        Margin="0,3,0,0"
                                        Background="{DynamicResource HighlightBackgroundBrush}"
                                        BorderBrush="{DynamicResource AccentColorBrush}"
                                        BorderThickness="2,0,0,0">
                                    <TextBlock x:Name="SelectedRouteEconomicsText"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="PinRouteButton"
                                Grid.Row="2"
                                Height="34"
                                IsEnabled="False"
                                Content="{DynamicResource Loc_TRADE_PIN_ROUTE}"
                                Click="PinRouteButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock x:Name="FooterText"
                       Grid.Row="4"
                       Margin="0,8,0,0"
                       FontSize="9"
                       Foreground="{DynamicResource MutedTextColorBrush}"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
