<UserControl x:Class="EDActivityOverlay.UserControls.TradeWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Compact Trade HUD. It is the normal activity surface and follows
             the global passive/interactive overlay protocol. -->
        <Border x:Name="CompactTradePanel"
                Padding="14,11"
                Background="{DynamicResource PrimaryBackgroundColorBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="CompactTradeDragHandle"
                      MouseLeftButtonDown="CompactTradeDragHandle_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_TRADE_WORKSPACE_TITLE}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                        <TextBlock x:Name="CompactJournalContextText"
                                   Margin="0,2,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource AccentColorBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="30"
                            Height="26"
                            Padding="0"
                            Content="×"
                            Foreground="{DynamicResource AccentColorBrush}"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            Click="CloseButton_Click"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,9,0,7"
                        Padding="9,6"
                        Background="{DynamicResource HighlightBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentColorBrush}"
                        BorderThickness="2,0,0,0">
                    <TextBlock x:Name="CompactFiltersText"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                </Border>

                <Border Grid.Row="2"
                        Padding="9,7"
                        Background="{DynamicResource SecondaryBackgroundColorBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="CompactStatusText"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentColorBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="CompactBestRouteText"
                                   Margin="0,5,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource PrimaryTextColorBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CompactActionButton"
                            Grid.Column="0"
                            Height="30"
                            Content="{DynamicResource Loc_SEARCH_ROUTES}"
                            Foreground="{DynamicResource PrimaryTextColorBrush}"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            Click="CompactActionButton_Click"/>
                    <Button x:Name="CompactSellCargoButton"
                            Grid.Column="2"
                            Height="30"
                            IsEnabled="False"
                            Content="{DynamicResource Loc_TRADE_ACTIVE_SELL_CARGO}"
                            Foreground="{DynamicResource PrimaryTextColorBrush}"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            Click="CompactSellCargoButton_Click"/>
                    <Button x:Name="CompactSecondaryButton"
                            Grid.Column="4"
                            Height="30"
                            Content="{DynamicResource Loc_TRADE_MORE}"
                            Foreground="{DynamicResource PrimaryTextColorBrush}"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            Click="CompactSecondaryButton_Click"/>
                </Grid>
                <TextBlock x:Name="CompactFooterText"
                           Grid.Row="4"
                           Margin="0,7,0,0"
                           FontSize="8"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextColorBrush}"/>
            </Grid>
        </Border>

        <!-- Full Trade assistant. Same top-level window, different internal
             view. Host enters exclusive interaction while this panel is open. -->
        <Border x:Name="FullTradePanel"
                Visibility="Collapsed"
                Padding="16"
                Background="{DynamicResource PrimaryBackgroundColorBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_TRADE_WORKSPACE_TITLE}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                        <TextBlock x:Name="JournalContextText"
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinWidth="96"
                            Height="34"
                            Padding="10,3"
                            Content="{DynamicResource Loc_TRADE_COLLAPSE}"
                            Foreground="{DynamicResource PrimaryTextColorBrush}"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            Click="CollapseButton_Click"/>
                    <Button Grid.Column="3"
                            MinWidth="88"
                            Height="34"
                            Padding="10,3"
                            Content="{DynamicResource Loc_CLOSE}"
                            Foreground="{DynamicResource PrimaryTextColorBrush}"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            Click="CloseButton_Click"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,9,0,6"
                        Padding="9,7"
                        Background="{DynamicResource SecondaryBackgroundColorBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.62*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.72*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.72*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.68*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Loc_TRADE_ANCHOR_SYSTEM}"
                                       FontSize="8"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                            <TextBox x:Name="AnchorSystemTextBox"
                                     Height="26"
                                     Margin="0,2,0,0"
                                     VerticalContentAlignment="Center"
                                     Style="{DynamicResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Loc_TRADE_CARGO_FREE}"
                                       FontSize="8"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                            <TextBox x:Name="CargoTextBox"
                                     Height="26"
                                     Margin="0,2,0,0"
                                     VerticalContentAlignment="Center"
                                     Style="{DynamicResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{DynamicResource Loc_TRADE_SOURCE_RADIUS}"
                                       FontSize="8"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                            <ComboBox x:Name="SourceRadiusComboBox"
                                      Height="26"
                                      Margin="0,2,0,0"
                                      Style="{DynamicResource ComboBoxStyle}">
                                <ComboBoxItem Content="10 LY" Tag="10"/>
                                <ComboBoxItem Content="20 LY" Tag="20"/>
                                <ComboBoxItem Content="30 LY" Tag="30"/>
                                <ComboBoxItem Content="40 LY" Tag="40"/>
                                <ComboBoxItem Content="50 LY" Tag="50"/>
                                <ComboBoxItem Content="60 LY" Tag="60"/>
                                <ComboBoxItem Content="80 LY" Tag="80"/>
                                <ComboBoxItem Content="100 LY" Tag="100"/>
                                <ComboBoxItem Content="150 LY" Tag="150"/>
                                <ComboBoxItem Content="200 LY" Tag="200"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{DynamicResource Loc_TRADE_TARGET_RADIUS}"
                                       FontSize="8"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                            <ComboBox x:Name="TargetRadiusComboBox"
                                      Height="26"
                                      Margin="0,2,0,0"
                                      Style="{DynamicResource ComboBoxStyle}">
                                <ComboBoxItem Content="10 LY" Tag="10"/>
                                <ComboBoxItem Content="20 LY" Tag="20"/>
                                <ComboBoxItem Content="30 LY" Tag="30"/>
                                <ComboBoxItem Content="40 LY" Tag="40"/>
                                <ComboBoxItem Content="50 LY" Tag="50"/>
                                <ComboBoxItem Content="60 LY" Tag="60"/>
                                <ComboBoxItem Content="80 LY" Tag="80"/>
                                <ComboBoxItem Content="100 LY" Tag="100"/>
                                <ComboBoxItem Content="150 LY" Tag="150"/>
                                <ComboBoxItem Content="200 LY" Tag="200"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="{DynamicResource Loc_TRADE_MAX_AGE}"
                                       FontSize="8"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                            <ComboBox x:Name="MaxAgeComboBox"
                                      Height="26"
                                      Margin="0,2,0,0"
                                      Style="{DynamicResource ComboBoxStyle}">
                                <ComboBoxItem Content="8 h" Tag="8"/>
                                <ComboBoxItem Content="16 h" Tag="16"/>
                                <ComboBoxItem Content="1 d" Tag="24"/>
                                <ComboBoxItem Content="2 d" Tag="48"/>
                                <ComboBoxItem Content="3 d" Tag="72"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="10">
                            <TextBlock Text="{DynamicResource Loc_TRADE_ROUTE_MODE}"
                                       FontSize="8"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                            <ComboBox x:Name="RouteModeComboBox"
                                      Height="26"
                                      Margin="0,2,0,0"
                                      Style="{DynamicResource ComboBoxStyle}"
                                      SelectionChanged="RouteModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Loc_TRADE_MODE_ONE_WAY}" Tag="oneway"/>
                                <ComboBoxItem Content="{DynamicResource Loc_TRADE_MODE_ROUND_TRIP}" Tag="roundtrip"/>
                                <ComboBoxItem Content="{DynamicResource Loc_TRADE_MODE_SELL_CARGO}" Tag="cargo"/>
                            </ComboBox>
                        </StackPanel>

                        <Button x:Name="SyncJournalButton"
                                Grid.Column="12"
                                Height="26"
                                MinWidth="118"
                                Padding="9,2"
                                VerticalAlignment="Bottom"
                                Content="{DynamicResource Loc_TRADE_SYNC_JOURNAL}"
                                Foreground="{DynamicResource PrimaryTextColorBrush}"
                                Background="{DynamicResource HighlightBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                Click="SyncJournalButton_Click"/>

                        <Button x:Name="AdvancedFiltersButton"
                                Grid.Column="14"
                                Width="108"
                                Height="26"
                                Padding="7,2"
                                VerticalAlignment="Bottom"
                                Foreground="{DynamicResource AccentColorBrush}"
                                Background="{DynamicResource HighlightBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                Click="AdvancedFiltersButton_Click">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="AdvancedFiltersButtonText"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="9"
                                           Foreground="{DynamicResource AccentColorBrush}"/>
                                <TextBlock x:Name="AdvancedFiltersArrowText"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="▼"
                                           FontSize="8"
                                           Foreground="{DynamicResource AccentColorBrush}"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="AdvancedFiltersPanel"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="15"
                                Visibility="Collapsed"
                                Margin="0,7,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Loc_TRADE_MIN_PAD}"
                                               FontSize="8"
                                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <ComboBox x:Name="MinPadComboBox"
                                              Height="26"
                                              Margin="0,2,0,0"
                                              Style="{DynamicResource ComboBoxStyle}">
                                        <ComboBoxItem Content="{DynamicResource Loc_TRADE_PAD_ANY}" Tag="1"/>
                                        <ComboBoxItem Content="{DynamicResource Loc_TRADE_PAD_MEDIUM}" Tag="2"/>
                                        <ComboBoxItem Content="{DynamicResource Loc_TRADE_PAD_LARGE}" Tag="3"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Loc_TRADE_MAX_STATION_DISTANCE}"
                                               FontSize="8"
                                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <ComboBox x:Name="MaxStationDistanceComboBox"
                                              Height="26"
                                              Margin="0,2,0,0"
                                              Style="{DynamicResource ComboBoxStyle}">
                                        <ComboBoxItem Content="{DynamicResource Loc_TRADE_ANY}" Tag="0"/>
                                        <ComboBoxItem Content="100 ls" Tag="100"/>
                                        <ComboBoxItem Content="500 ls" Tag="500"/>
                                        <ComboBoxItem Content="1 000 ls" Tag="1000"/>
                                        <ComboBoxItem Content="2 000 ls" Tag="2000"/>
                                        <ComboBoxItem Content="5 000 ls" Tag="5000"/>
                                        <ComboBoxItem Content="10 000 ls" Tag="10000"/>
                                        <ComboBoxItem Content="25 000 ls" Tag="25000"/>
                                        <ComboBoxItem Content="50 000 ls" Tag="50000"/>
                                        <ComboBoxItem Content="100 000 ls" Tag="100000"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{DynamicResource Loc_TRADE_MIN_SUPPLY}"
                                               FontSize="8"
                                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <ComboBox x:Name="MinSupplyComboBox"
                                              Height="26"
                                              Margin="0,2,0,0"
                                              Style="{DynamicResource ComboBoxStyle}">
                                        <ComboBoxItem Content="{DynamicResource Loc_TRADE_ANY}" Tag="1"/>
                                        <ComboBoxItem Content="100" Tag="100"/>
                                        <ComboBoxItem Content="500" Tag="500"/>
                                        <ComboBoxItem Content="1 000" Tag="1000"/>
                                        <ComboBoxItem Content="2 500" Tag="2500"/>
                                        <ComboBoxItem Content="5 000" Tag="5000"/>
                                        <ComboBoxItem Content="10 000" Tag="10000"/>
                                        <ComboBoxItem Content="50 000" Tag="50000"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="{DynamicResource Loc_TRADE_MIN_DEMAND}"
                                               FontSize="8"
                                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <ComboBox x:Name="MinDemandComboBox"
                                              Height="26"
                                              Margin="0,2,0,0"
                                              Style="{DynamicResource ComboBoxStyle}">
                                        <ComboBoxItem Content="{DynamicResource Loc_TRADE_ANY}" Tag="1"/>
                                        <ComboBoxItem Content="100" Tag="100"/>
                                        <ComboBoxItem Content="500" Tag="500"/>
                                        <ComboBoxItem Content="1 000" Tag="1000"/>
                                        <ComboBoxItem Content="2 500" Tag="2500"/>
                                        <ComboBoxItem Content="5 000" Tag="5000"/>
                                        <ComboBoxItem Content="10 000" Tag="10000"/>
                                        <ComboBoxItem Content="50 000" Tag="50000"/>
                                    </ComboBox>
                                </StackPanel>

                                <CheckBox x:Name="FleetCarriersCheckBox"
                                          Grid.Column="8"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,5"
                                          Foreground="{DynamicResource PrimaryTextColorBrush}"
                                          Content="{DynamicResource Loc_TRADE_INCLUDE_FLEET_CARRIERS}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SearchButton"
                            Width="170"
                            Height="32"
                            Content="{DynamicResource Loc_SEARCH_ROUTES}"
                            Foreground="{DynamicResource PrimaryTextColorBrush}"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            Click="SearchButton_Click"/>
                    <TextBlock x:Name="SearchStatusText"
                               Grid.Column="1"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_TRADE_SORT}"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                        <ComboBox x:Name="SortComboBox"
                                  Width="170"
                                  Height="28"
                                  Style="{DynamicResource ComboBoxStyle}"
                                  SelectionChanged="SortComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="PrimaryProfitSortItem" Content="{DynamicResource Loc_TRADE_SORT_PROFIT}" Tag="profit"/>
                            <ComboBoxItem x:Name="PerHourSortItem" Content="{DynamicResource Loc_TRADE_SORT_PER_HOUR}" Tag="perhour"/>
                            <ComboBoxItem Content="{DynamicResource Loc_TRADE_SORT_FASTEST}" Tag="time"/>
                            <ComboBoxItem x:Name="PerTonSortItem" Content="{DynamicResource Loc_TRADE_SORT_PER_TON}" Tag="perton"/>
                            <ComboBoxItem Content="{DynamicResource Loc_TRADE_SORT_DISTANCE}" Tag="distance"/>
                            <ComboBoxItem x:Name="ConfidenceSortItem" Content="{DynamicResource Loc_TRADE_SORT_CONFIDENCE}" Tag="confidence"/>
                            <ComboBoxItem Content="{DynamicResource Loc_TRADE_SORT_FRESHEST}" Tag="freshness"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="8"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="2,0,2,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RoutesSummaryText"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColorBrush}"/>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Foreground="{DynamicResource MutedTextColorBrush}"
                                           Text="{DynamicResource Loc_TRADE_PAGE_SIZE_HINT}"/>
                            </Grid>

                            <ListBox x:Name="RoutesList"
                                     Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionMode="Single"
                                     SelectionChanged="RoutesList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,3"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColorBrush}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="RouteItemBorder"
                                                            Padding="9,7"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter ContentSource="Content"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryTextColorBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SelectedRowBackgroundBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedRowBorderBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.05*"/>
                                                <ColumnDefinition Width="2.7*"/>
                                                <ColumnDefinition Width="1.15*"/>
                                                <ColumnDefinition Width="0.75*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                           Text="{Binding Commodity}"/>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource MutedTextColorBrush}"
                                                           Text="{Binding HeldLabel}"/>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="8"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentColorBrush}"
                                                           Text="{Binding Confidence}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="10"
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                           Text="{Binding Source}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource SecondaryTextColorBrush}"
                                                           Text="{Binding Target}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SuccessColorBrush}"
                                                           Text="{Binding ProfitPerTrip}"/>
                                                <TextBlock HorizontalAlignment="Right"
                                                           Margin="0,2,0,0"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource SecondaryTextColorBrush}"
                                                           Text="{Binding ProfitPerTon}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontSize="10"
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                           Text="{Binding TradeLegDistance}"/>
                                                <TextBlock HorizontalAlignment="Right"
                                                           Margin="0,2,0,0"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentColorBrush}"
                                                           Text="{Binding TravelTime}"/>
                                                <TextBlock HorizontalAlignment="Right"
                                                           Margin="0,1,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource SuccessColorBrush}"
                                                           Text="{Binding CreditsPerHour}"/>
                                                <TextBlock HorizontalAlignment="Right"
                                                           Margin="0,1,0,0"
                                                           FontSize="8"
                                                           Foreground="{DynamicResource MutedTextColorBrush}"
                                                           Text="{Binding Age}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="2" Margin="2,7,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PreviousPageButton"
                                        MinWidth="92"
                                        Height="28"
                                        Padding="9,2"
                                        Content="{DynamicResource Loc_TRADE_PREVIOUS_PAGE}"
                                        Foreground="{DynamicResource PrimaryTextColorBrush}"
                                        Background="{DynamicResource ButtonBackgroundColorBrush}"
                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                        Click="PreviousPageButton_Click"/>
                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="9"
                                               Foreground="{DynamicResource MutedTextColorBrush}"
                                               Text="{DynamicResource Loc_TRADE_PAGE}"/>
                                    <TextBlock x:Name="PageIndicatorText"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                </StackPanel>
                                <Button x:Name="NextPageButton"
                                        Grid.Column="2"
                                        MinWidth="92"
                                        Height="28"
                                        Padding="9,2"
                                        Content="{DynamicResource Loc_TRADE_NEXT_PAGE}"
                                        Foreground="{DynamicResource PrimaryTextColorBrush}"
                                        Background="{DynamicResource ButtonBackgroundColorBrush}"
                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                        Click="NextPageButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="13"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedCommodityText"
                                           Text="{DynamicResource Loc_TRADE_SELECT_ROUTE}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentColorBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="SelectedProfitText"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextColorBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1"
                                          Margin="0,10,0,10"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedSourceLabelText"
                                               Text="{DynamicResource Loc_TRADE_SOURCE}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <TextBlock x:Name="SelectedSourceText"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                    <TextBlock x:Name="SelectedSourceMetaText"
                                               Margin="0,3,0,10"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextColorBrush}"/>

                                    <TextBlock x:Name="SelectedTargetLabelText"
                                               Text="{DynamicResource Loc_TRADE_TARGET}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <TextBlock x:Name="SelectedTargetText"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                    <TextBlock x:Name="SelectedTargetMetaText"
                                               Margin="0,3,0,10"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextColorBrush}"/>

                                    <Border Padding="9,9"
                                            Margin="0,3,0,0"
                                            Background="{DynamicResource HighlightBackgroundBrush}"
                                            BorderBrush="{DynamicResource AccentColorBrush}"
                                            BorderThickness="2,0,0,0">
                                        <TextBlock x:Name="SelectedRouteEconomicsText"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                    </Border>

                                    <Border x:Name="SelectedConfidencePanel"
                                            Visibility="Collapsed"
                                            Padding="9,9"
                                            Margin="0,7,0,0"
                                            Background="{DynamicResource HighlightBackgroundBrush}"
                                            BorderBrush="{DynamicResource AccentColorBrush}"
                                            BorderThickness="2,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_TRADE_CONFIDENCE_TITLE}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentColorBrush}"/>
                                            <TextBlock x:Name="SelectedConfidenceText"
                                                       Margin="0,4,0,0"
                                                       FontSize="9"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="9,9"
                                            Margin="0,7,0,0"
                                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_TRADE_TRAVEL_ESTIMATE}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentColorBrush}"/>
                                            <TextBlock x:Name="SelectedTravelEstimateText"
                                                       Margin="0,4,0,0"
                                                       FontSize="9"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <Button x:Name="PinRouteButton"
                                    Grid.Row="2"
                                    Height="34"
                                    IsEnabled="False"
                                    Content="{DynamicResource Loc_TRADE_PIN_ROUTE}"
                                    Foreground="{DynamicResource PrimaryTextColorBrush}"
                                    Background="{DynamicResource SecondaryBackgroundColorBrush}"
                                    BorderBrush="{DynamicResource AccentColorBrush}"
                                    Click="PinRouteButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="FooterText"
                           Grid.Row="4"
                           Margin="0,8,0,0"
                           FontSize="9"
                           Foreground="{DynamicResource MutedTextColorBrush}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
