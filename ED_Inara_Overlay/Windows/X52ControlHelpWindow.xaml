<Window x:Class="ED_Inara_Overlay.Windows.X52ControlHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_CONTROL_CHEATSHEET}"
        Width="880" Height="720" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryBackgroundColorBrush}"
        Foreground="{DynamicResource PrimaryTextColorBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Loc_CONTROL_CHEATSHEET}" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource AccentColorBrush}"/>
        <TextBlock x:Name="ProfilePathText" Grid.Row="1" Margin="0,5,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextColorBrush}"/>
        <TextBox x:Name="CheatsheetText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13"/>
        <Button Grid.Row="3" Content="{DynamicResource Loc_CLOSE}" Width="110" Height="34"
                HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>
