<Window x:Class="ED_Inara_Overlay.Windows.PinnedRouteOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_Pinned_trade_route}" Height="226" Width="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid Margin="3">
        <Border x:Name="OverlayFrame" Padding="12,8"
                Background="{DynamicResource PrimaryBackgroundColorBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="DragHandle" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource HighlightBackgroundBrush}" Padding="7,2" Margin="0,0,10,0">
                    <TextBlock x:Name="LegText" Text="{DynamicResource Loc_LEG_1_1}" Foreground="{DynamicResource AccentColorBrush}"
                               FontSize="10" FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="ActionText" Grid.Column="1" Text="{DynamicResource Loc_FLY_TO_BUY}"
                           Foreground="{DynamicResource PrimaryTextColorBrush}" FontWeight="Bold" FontSize="14"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="InteractionHint" Text="{DynamicResource Loc_CTRL_6_INTERACT}" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextColorBrush}" FontSize="9" Margin="0,0,8,0"/>
                    <Button x:Name="UnpinButton" Content="{DynamicResource Loc_UNPIN}" Padding="7,2" FontSize="9"
                            Visibility="Collapsed" Click="UnpinButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CommodityText" Text="{DynamicResource Loc_Pinned_route_example}"
                               Foreground="{DynamicResource SecondaryTextColorBrush}" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="JumpsText" Text="{DynamicResource Loc_ROUTE_NOT_PLOTTED}"
                               Foreground="{DynamicResource AccentColorBrush}" HorizontalAlignment="Right" FontSize="11"/>
                    <TextBlock x:Name="ProfitText" Text="{DynamicResource Loc_PLANNED_PROFIT}"
                               Foreground="{DynamicResource SuccessColorBrush}" HorizontalAlignment="Right" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Margin="0,8,0,0" Padding="7,5"
                    Background="{DynamicResource SecondaryBackgroundColorBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Loc_FROM}" Foreground="{DynamicResource AccentColorBrush}"
                                   FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FromPointText" Grid.Column="1" Text="SOL / ABRAHAM LINCOLN"
                                   Style="{DynamicResource ClickableTextStyle}" FontSize="10"
                                   ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                                   MouseLeftButtonUp="FromPointText_MouseLeftButtonUp"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button x:Name="CopyFromStationButton" Grid.Column="2" Content="{DynamicResource Loc_COPY_STATION_SHORT}"
                                ToolTip="{DynamicResource Loc_COPY_STATION}" Margin="4,0,0,0" Padding="6,1" FontSize="8"
                                Visibility="Collapsed" Click="CopyFromStationButton_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Loc_TO}" Foreground="{DynamicResource AccentColorBrush}"
                                   FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToPointText" Grid.Column="1" Text="ALPHA CENTAURI / HUTTON ORBITAL"
                                   Style="{DynamicResource ClickableTextStyle}" FontSize="10"
                                   ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                                   MouseLeftButtonUp="ToPointText_MouseLeftButtonUp"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button x:Name="CopyToStationButton" Grid.Column="2" Content="{DynamicResource Loc_COPY_STATION_SHORT}"
                                ToolTip="{DynamicResource Loc_COPY_STATION}" Margin="4,0,0,0" Padding="6,1" FontSize="8"
                                Visibility="Collapsed" Click="CopyToStationButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="0,7,0,0" Padding="7,3"
                    Background="{DynamicResource SecondaryBackgroundColorBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0">
                <TextBlock x:Name="NoteText" Text="{DynamicResource Loc_Waiting_for_journal_data}"
                           Foreground="{DynamicResource MutedTextColorBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </Border>

            <Grid x:Name="NavigationPanel" Grid.Row="4" Margin="0,7,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RouteNavigationStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="9" Foreground="{DynamicResource MutedTextColorBrush}"/>
                <Button Grid.Column="1" Margin="7,0,0,0" Padding="7,2" FontSize="9"
                        Content="{DynamicResource Loc_PREPARE_IN_GALAXY_MAP}"
                        Click="PrepareNavigationButton_Click"/>
                <Button x:Name="AutomaticNavigationButton" Grid.Column="2" Margin="7,0,0,0" Padding="7,2" FontSize="9"
                        Content="{DynamicResource Loc_AUTO_PLOT_EXPERIMENTAL}"
                        Click="AutomaticNavigationButton_Click"/>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
