<Window x:Class="ED_Inara_Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ED Inara Overlay" Height="166" Width="235"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border x:Name="OverlayFrame" Margin="4" Padding="10,7" BorderThickness="1"
            BorderBrush="{DynamicResource BorderColorBrush}"
            Background="{DynamicResource PrimaryBackgroundColorBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Loc_ED_ASSISTANT}" FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                <Border Grid.Column="1" Background="{DynamicResource HighlightBackgroundBrush}" Padding="6,1">
                    <TextBlock x:Name="InteractionStatusBadge" Text="{DynamicResource Loc_PASSIVE}"
                               Foreground="{DynamicResource AccentColorBrush}" FontSize="10" FontWeight="Bold"/>
                </Border>
            </Grid>
            <TextBlock x:Name="LocationStatusText" Grid.Row="1" Text="{DynamicResource Loc_JOURNAL_WAITING}"
                       Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextColorBrush}"
                       FontSize="11" TextTrimming="CharacterEllipsis"/>
            <ComboBox x:Name="ActivitySelector" Grid.Row="2" Height="27" FontSize="10"
                          Margin="0,7,0,0" HorizontalAlignment="Stretch"
                          Style="{DynamicResource ComboBoxStyle}"
                          DisplayMemberPath="Label"
                          SelectionChanged="ActivitySelector_SelectionChanged"/>
            <Button x:Name="ActivitySettingsButton" Grid.Row="3" Content="{DynamicResource Loc_SETTINGS_2}"
                    Height="27" Margin="0,6,0,0" FontSize="9"
                    Click="ActivitySettingsButton_Click"/>
            <TextBlock x:Name="InteractionHintText" Grid.Row="4"
                       Text="{DynamicResource Loc_Ctrl_5_visibility_Ctrl_6_cursor_Ctrl_1_4_section}"
                       Margin="0,5,0,0" Foreground="{DynamicResource MutedTextColorBrush}"
                       FontSize="9" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
