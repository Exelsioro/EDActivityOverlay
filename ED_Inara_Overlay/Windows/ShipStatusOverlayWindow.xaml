<Window x:Class="ED_Inara_Overlay.Windows.ShipStatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_SHIP_STATUS_WIDGET}" Width="560" Height="92"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize">
    <Grid Margin="3">
        <Border x:Name="OverlayFrame" Padding="12,8"
                Background="{DynamicResource PrimaryBackgroundColorBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="DragHandle" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_CURRENT_SYSTEM_SHORT}" FontSize="8"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                        <TextBlock x:Name="CurrentSystemText" Style="{DynamicResource ClickableTextStyle}"
                                   ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                                   MouseLeftButtonUp="CurrentSystemText_MouseLeftButtonUp"
                                   FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="→" Margin="14,8" FontSize="16"
                               Foreground="{DynamicResource AccentColorBrush}"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="RouteCaptionText" Text="{DynamicResource Loc_NEXT_SYSTEM_SHORT}" FontSize="8"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                        <TextBlock x:Name="NextSystemText" Style="{DynamicResource ClickableTextStyle}"
                                   ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                                   MouseLeftButtonUp="NextSystemText_MouseLeftButtonUp"
                                   FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="AdvisoryPanel" Grid.Row="1" Margin="0,7,0,0" Padding="7,4"
                        Background="{DynamicResource HighlightBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="2,0,0,0">
                    <TextBlock x:Name="AdvisoryText" TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
