<Window x:Class="ED_Inara_Overlay.Windows.ActivityWorkspaceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_Activity_assistant}" Width="420" Height="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
    <Grid x:Name="CompactPanel" Margin="3">
        <Border x:Name="OverlayFrame" Padding="14,11"
                Background="{DynamicResource PrimaryBackgroundColorBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="DragHandle" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="{DynamicResource Loc_EXPLORATION}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                    <TextBlock x:Name="ModuleStatusText" Text="{DynamicResource Loc_JOURNAL_ASSISTANT}"
                               FontSize="10" Foreground="{DynamicResource AccentColorBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="InteractionHint" Text="{DynamicResource Loc_CTRL_6_INTERACT}" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextColorBrush}" FontSize="9" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>

            <Border x:Name="LegacyLocationPanel" Grid.Row="1" Margin="0,10,0,8" Padding="9,6"
                    Background="{DynamicResource HighlightBackgroundBrush}">
                <StackPanel>
                    <TextBlock x:Name="LocationText" Text="{DynamicResource Loc_SYSTEM}"
                               Style="{DynamicResource ClickableTextStyle}"
                               ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                               MouseLeftButtonUp="CopyCurrentSystemText_MouseLeftButtonUp"/>
                    <TextBlock x:Name="FlightStateText" Text="{DynamicResource Loc_Waiting_for_journal}"
                               FontSize="10" Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                    <TextBlock x:Name="ExternalDataText" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                               FontSize="9" Foreground="{DynamicResource MutedTextColorBrush}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <StackPanel x:Name="AdaptiveExplorationPanel" Visibility="Collapsed">
                    <Border Padding="9,7" Margin="0,1,0,7"
                            Background="{DynamicResource HighlightBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            BorderThickness="2,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CompactModeText"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColorBrush}"/>
                                <TextBlock x:Name="CompactContextTitleText"
                                           Margin="0,2,0,0"
                                           FontSize="15" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="CompactQueueCountText"
                                       Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       FontSize="9"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                        </Grid>
                    </Border>

                    <Border x:Name="SystemContextPanel"
                            Padding="9,7" Margin="0,0,0,7"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="1,0,0,0">
                        <StackPanel>
                            <ItemsControl x:Name="CompactTargetsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Margin="0,0,0,4"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="CompactEmptyTargetsText"
                                       Visibility="Collapsed"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BodyContextPanel"
                            Visibility="Collapsed"
                            Padding="9,7" Margin="0,0,0,7"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            BorderThickness="1,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="BodyStatusText"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                            <TextBlock x:Name="BodyObjectiveText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                            <TextBlock x:Name="BodyMissingText"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{DynamicResource AccentColorBrush}"/>
                            <TextBlock x:Name="BodyMetaText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="9"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ExobioContextPanel"
                                Visibility="Collapsed">
                        <Border x:Name="SurfaceNavigationPanel"
                                Padding="9,7" Margin="0,0,0,5"
                                Background="{DynamicResource HighlightBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentColorBrush}"
                                BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="SurfaceRadar"
                                      Width="50" Height="50"
                                      VerticalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource BorderColorBrush}"
                                             StrokeThickness="1"/>
                                    <Ellipse Width="30" Height="30"
                                             Stroke="{DynamicResource MutedTextColorBrush}"
                                             StrokeThickness="1"
                                             StrokeDashArray="2,2"/>
                                    <Ellipse Width="4" Height="4"
                                             Fill="{DynamicResource PrimaryTextColorBrush}"/>
                                    <Path Data="M 25,4 L 20,15 L 25,12 L 30,15 Z"
                                          Fill="{DynamicResource AccentColorBrush}"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="SurfaceEscapeArrowTransform"
                                                             Angle="0"
                                                             CenterX="25"
                                                             CenterY="25"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="SurfaceNavigationText"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ExobioBodyProgressText"
                                   Margin="9,0,9,5"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                    </StackPanel>

                    <Border x:Name="CompactRouteAlertPanel"
                            Visibility="Collapsed"
                            Padding="9,6"
                            Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="1,0,0,0">
                        <TextBlock x:Name="CompactRouteAlertText"
                                   TextWrapping="Wrap"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedTextColorBrush}"/>
                    </Border>
                </StackPanel>

                <ScrollViewer x:Name="LegacyCompactScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock x:Name="PrimaryHintText"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,9"
                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                        <Border x:Name="FuelAdvicePanel"
                                Padding="9,7" Margin="0,0,0,7"
                                Visibility="Collapsed"
                                Background="{DynamicResource SecondaryBackgroundColorBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1,0,0,0">
                            <TextBlock x:Name="FuelAdviceText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                        </Border>
                        <Border x:Name="ExplorationPoiPanel"
                                Padding="9,7" Margin="0,0,0,7"
                                Visibility="Collapsed"
                                Background="{DynamicResource SecondaryBackgroundColorBrush}"
                                BorderBrush="{DynamicResource AccentColorBrush}"
                                BorderThickness="1,0,0,0">
                            <TextBlock x:Name="ExplorationPoiText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                        </Border>
                        <Border Padding="9,7"
                                Background="{DynamicResource SecondaryBackgroundColorBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1,0,0,0">
                            <TextBlock x:Name="PlannedFeaturesText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextColorBrush}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterHintText" Text="{DynamicResource Loc_Switch_activities_in_the_main_window}"
                           VerticalAlignment="Center" TextWrapping="Wrap" FontSize="9"
                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                <Button x:Name="OpenExplorationAssistantButton" Grid.Column="1" Margin="8,0,0,0"
                        Padding="9,3" Content="{DynamicResource Loc_Open_full_exploration_assistant}"
                        Click="OpenExplorationAssistantButton_Click"/>
            </Grid>
        </Grid>
        </Border>
    </Grid>

    <Border x:Name="FullExplorationPanel" Visibility="Collapsed" Margin="3" Padding="16"
            Background="{DynamicResource PrimaryBackgroundColorBrush}"
            BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc_EXPLORATION_SYSTEM_ASSISTANT}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                    <TextBlock x:Name="FullSystemSummaryText" Margin="0,3,0,0"
                               Style="{DynamicResource ClickableTextStyle}"
                               ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                               MouseLeftButtonUp="CopyCurrentSystemText_MouseLeftButtonUp"/>
                </StackPanel>
                <Button Grid.Column="1" Width="88" Height="34" Content="{DynamicResource Loc_CLOSE}"
                        Click="CloseExplorationAssistantButton_Click"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,14,0,12" Padding="10"
                    Background="{DynamicResource HighlightBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="FullOverviewText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CatalogSearchTextBox" Style="{DynamicResource TextBoxStyle}"
                             ToolTip="{DynamicResource Loc_Exploration_search_hint}"
                             TextChanged="CatalogFilterChanged"/>
                    <ComboBox x:Name="CatalogFilterComboBox" Grid.Column="2" Style="{DynamicResource ComboBoxStyle}"
                              DisplayMemberPath="Label" SelectionChanged="CatalogFilterChanged"/>
                    <TextBlock x:Name="CatalogSourceText" Grid.Column="4" VerticalAlignment="Center"
                               TextAlignment="Right" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextColorBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <TabControl Grid.Row="2" Style="{DynamicResource EliteTabControlStyle}">
            <TabItem Header="{DynamicResource Loc_SYSTEM_CATALOG}" Style="{DynamicResource EliteTabItemStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.15*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="ExplorationBodiesGrid" SelectionChanged="ExplorationBodiesGrid_SelectionChanged"
                          AlternationCount="2" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc_BODY}" Binding="{Binding Name}" Width="1.35*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_TYPE}" Binding="{Binding Type}" Width="1.25*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_REASON}" Binding="{Binding Highlights}" Width="1.45*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_DISTANCE_LS}" Binding="{Binding Distance}" Width="0.8*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_MAPPING_VALUE}" Binding="{Binding MappingValue}" Width="1*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_STATUS}" Binding="{Binding Progress}" Width="1.05*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_EXPLORATION_VISIT_STATE}" Binding="{Binding VisitState}" Width="0.9*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="2" Padding="13" Background="{DynamicResource SecondaryBackgroundColorBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedBodyNameText" Text="{DynamicResource Loc_Select_a_body}"
                                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedBodyReasonText" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Margin="0,12,0,10" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="SelectedBodyDetailsText" TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="CopySelectedBodyButton" Content="{DynamicResource Loc_COPY_BODY_NAME}"
                                    IsEnabled="False" Click="CopySelectedBodyButton_Click"/>
                            <Button x:Name="BookmarkSelectedBodyButton" Margin="0,7,0,0"
                                    Content="{DynamicResource Loc_MARK_NOTABLE_FINDING}"
                                    IsEnabled="False" Click="BookmarkSelectedBodyButton_Click"/>
                            <Button x:Name="DeferSelectedBodyButton" Margin="0,7,0,0"
                                    Visibility="Collapsed"
                                    Content="{DynamicResource Loc_EXPLORATION_DEFER_THIS_VISIT}"
                                    Click="DeferSelectedBodyButton_Click"/>
                            <Button x:Name="ResumeSelectedBodyButton" Margin="0,7,0,0"
                                    Visibility="Collapsed"
                                    Content="{DynamicResource Loc_EXPLORATION_RESUME_BODY}"
                                    Click="ResumeSelectedBodyButton_Click"/>
                            <TextBlock x:Name="CurrentSystemLinkText" Margin="0,10,0,2"
                                       Style="{DynamicResource ClickableTextStyle}"
                                       ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                                       MouseLeftButtonUp="CopyCurrentSystemText_MouseLeftButtonUp"/>
                            <Button x:Name="CopyPoiSystemButton" Margin="0,7,0,0" IsEnabled="False"
                                    Content="{DynamicResource Loc_COPY_POI_SYSTEM}" Click="CopyPoiSystemButton_Click"/>
                            <Button x:Name="OpenPoiDetailsButton" Margin="0,7,0,0" IsEnabled="False"
                                    Content="{DynamicResource Loc_OPEN_POI_DETAILS}" Click="OpenPoiDetailsButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc_EXPLORATION_LOG}" Style="{DynamicResource EliteTabItemStyle}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="BookmarkedOnlyCheckBox" Content="{DynamicResource Loc_BOOKMARKED_ONLY}"
                              Foreground="{DynamicResource PrimaryTextColorBrush}"
                              Checked="ExplorationLogFilterChanged" Unchecked="ExplorationLogFilterChanged"/>
                    <DataGrid x:Name="ExplorationLogGrid" Grid.Row="1" Margin="0,9,0,9"
                              SelectionMode="Single" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc_TIME}" Binding="{Binding Time}" Width="105"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_TYPE}" Binding="{Binding Kind}" Width="135"/>
                            <DataGridTemplateColumn Header="{DynamicResource Loc_SYSTEM}" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding System}" Tag="{Binding System}"
                                                   Style="{DynamicResource ClickableTextStyle}"
                                                   ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                                                   MouseLeftButtonUp="CopySystemText_MouseLeftButtonUp"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc_BODY}" Binding="{Binding Body}" Width="1.2*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_DETAILS}" Binding="{Binding Detail}" Width="1.8*"/>
                            <DataGridTextColumn Header="★" Binding="{Binding Bookmark}" Width="45"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Loc_TOGGLE_BOOKMARK}" Width="170"
                                Click="ToggleLogBookmarkButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Loc_ROUTE}" Style="{DynamicResource EliteTabItemStyle}">
                <ScrollViewer x:Name="RouteTabScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14" MaxWidth="760" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc_SPANSH_ROAD_TO_RICHES}" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentColorBrush}"/>
                            <Button x:Name="ToggleRouteFormButton" Grid.Column="1" Padding="10,3"
                                    Click="ToggleRouteFormButton_Click"/>
                        </Grid>
                        <StackPanel x:Name="RouteFormPanel">
                        <TextBlock Text="{DynamicResource Loc_SPANSH_DIRECT_ROUTE_DESCRIPTION}" Margin="0,4,0,14"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextColorBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="250"/><ColumnDefinition Width="20"/><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/>
                                <RowDefinition Height="36"/><RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Loc_ROUTE_SOURCE}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SpanshSourceTextBox" Grid.Column="1" Style="{DynamicResource TextBoxStyle}"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Loc_ROUTE_DESTINATION_OPTIONAL}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SpanshDestinationTextBox" Grid.Column="4" Style="{DynamicResource TextBoxStyle}"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Loc_JUMP_RANGE}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SpanshJumpRangeTextBox" Grid.Row="1" Grid.Column="1" Text="50" Style="{DynamicResource TextBoxStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource Loc_SEARCH_RADIUS}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SpanshRadiusTextBox" Grid.Row="1" Grid.Column="4" Text="25" Style="{DynamicResource TextBoxStyle}"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Loc_MAX_SYSTEMS}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SpanshMaxSystemsTextBox" Grid.Row="2" Grid.Column="1" Text="25" Style="{DynamicResource TextBoxStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{DynamicResource Loc_MAX_DISTANCE}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SpanshMaxDistanceTextBox" Grid.Row="2" Grid.Column="4" Text="1000" Style="{DynamicResource TextBoxStyle}"/>
                            <TextBlock Grid.Row="3" Text="{DynamicResource Loc_MIN_SCAN_VALUE}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SpanshMinValueTextBox" Grid.Row="3" Grid.Column="1" Text="500000" Style="{DynamicResource TextBoxStyle}"/>
                            <CheckBox x:Name="SpanshMappingValueCheckBox" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2"
                                      Content="{DynamicResource Loc_USE_MAPPING_VALUE}" IsChecked="True"/>
                            <CheckBox x:Name="SpanshLoopCheckBox" Grid.Row="4" Grid.ColumnSpan="2"
                                      Content="{DynamicResource Loc_RETURN_TO_START}"/>
                            <CheckBox x:Name="SpanshAvoidThargoidsCheckBox" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2"
                                      Content="{DynamicResource Loc_AVOID_THARGOIDS}" IsChecked="True"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="CalculateSpanshRouteButton" Width="210"
                                    Content="{DynamicResource Loc_CALCULATE_AND_IMPORT}" Click="CalculateSpanshRouteButton_Click"/>
                            <Button Width="150" Margin="8,0,0,0" Content="{DynamicResource Loc_IMPORT_ROUTE}"
                                    Click="ImportExplorationRouteButton_Click"/>
                            <Button Width="150" Margin="8,0,0,0" Content="{DynamicResource Loc_OPEN_SPANSH}"
                                    Click="OpenSpanshButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SpanshCalculationStatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                        </StackPanel>
                        <Border x:Name="RouteNavigationPanel" Margin="0,14,0,0" Padding="10"
                                BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1"
                                Background="{DynamicResource HighlightBackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc_NEXT_ROUTE_DESTINATION}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                    <TextBlock x:Name="NavigationTargetSystemLink" Margin="0,3,0,0"
                                               Style="{DynamicResource ClickableTextStyle}"
                                               ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                                               MouseLeftButtonUp="CopySystemText_MouseLeftButtonUp"/>
                                </StackPanel>
                                <Button Grid.Column="1" Width="180" Margin="10,0,0,0"
                                        Content="{DynamicResource Loc_PREPARE_IN_GALAXY_MAP}"
                                        Click="PrepareRouteNavigationButton_Click"/>
                                <Button x:Name="AutomaticRouteNavigationButton" Grid.Column="2" Width="170" Margin="8,0,0,0"
                                        Content="{DynamicResource Loc_AUTO_PLOT_EXPERIMENTAL}"
                                        Click="AutomaticRouteNavigationButton_Click"/>
                                <TextBlock x:Name="RouteNavigationStatusText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                            </Grid>
                        </Border>
                        <Border Margin="0,14,0,0" Padding="10"
                                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"
                                Background="{DynamicResource PrimaryBackgroundColorBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Loc_IMPORTED_ROUTE_STOPS}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                    <Button x:Name="ToggleRouteListButton" Grid.Column="1" Padding="10,3"
                                            Click="ToggleRouteListButton_Click"/>
                                </Grid>
                                <StackPanel x:Name="RouteStopsPanel">
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/><ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="№" Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Loc_ROUTE_STATE}" Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Loc_SYSTEM}" Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{DynamicResource Loc_ROUTE_TARGETS}" Foreground="{DynamicResource MutedTextColorBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{DynamicResource Loc_ROUTE_VALUE}" Foreground="{DynamicResource MutedTextColorBrush}"/>
                                </Grid>
                                <ItemsControl x:Name="RouteStopsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RouteStopBorder" Padding="4,6" Margin="0,1"
                                                    BorderBrush="{DynamicResource HighlightBackgroundBrush}"
                                                    BorderThickness="0,1,0,0" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/><ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Position}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentColorBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding System}" Tag="{Binding System}"
                                                               Style="{DynamicResource ClickableTextStyle}"
                                                               MouseLeftButtonUp="CopySystemText_MouseLeftButtonUp"
                                                               ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" FontWeight="SemiBold"
                                                               />
                                                    <TextBlock Grid.Column="3" Text="{Binding Targets}" VerticalAlignment="Center"
                                                               Margin="6,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding EstimatedValue}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="RouteStopBorder" Property="Background" Value="{DynamicResource HighlightBackgroundBrush}"/>
                                                    <Setter TargetName="RouteStopBorder" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                    <Setter TargetName="RouteStopBorder" Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="EmptyRouteStopsText" Margin="0,8,0,0"
                                           Text="{DynamicResource Loc_NO_EXPLORATION_ROUTE}"
                                           Foreground="{DynamicResource MutedTextColorBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource Loc_DSS_GUIDANCE}" Style="{DynamicResource EliteTabItemStyle}">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Padding="16" Background="{DynamicResource SecondaryBackgroundColorBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc_DSS_PROBE_LAYOUT}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentColorBrush}"/>
                            <TextBlock x:Name="DssSelectedBodyText" Text="{DynamicResource Loc_Select_a_body}"
                                       Margin="0,5,0,12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_DSS_SELECT_TARGET_HINT}" Margin="0,0,0,16"
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextColorBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_DSS_EFFICIENCY_TARGET}"
                                       Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                            <ComboBox x:Name="DssTargetComboBox" Height="34" Margin="0,5,0,16"
                                      Style="{DynamicResource ComboBoxStyle}"
                                      SelectionChanged="DssTargetComboBox_SelectionChanged"/>
                            <TextBlock x:Name="DssPatternText" TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextColorBrush}"/>
                            <TextBlock x:Name="DssMappingResultText" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="12" Background="{DynamicResource HighlightBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="DssPatternCanvas" Width="460" Height="460">
                                <Ellipse Canvas.Left="50" Canvas.Top="50" Width="360" Height="360"
                                         Fill="{DynamicResource SecondaryBackgroundColorBrush}"
                                         Stroke="{DynamicResource BorderColorBrush}" StrokeThickness="3"/>
                                <Ellipse Canvas.Left="84" Canvas.Top="84" Width="292" Height="292"
                                         Stroke="{DynamicResource MutedTextColorBrush}" StrokeThickness="2"
                                         StrokeDashArray="6,6"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>
            </TabItem>
            </TabControl>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CatalogCountText" Foreground="{DynamicResource MutedTextColorBrush}"/>
                    <TextBlock x:Name="ExplorationRouteInfoText" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextColorBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Width="130" Margin="8,0,0,0" Content="{DynamicResource Loc_IMPORT_ROUTE}"
                        Click="ImportExplorationRouteButton_Click"/>
                <Button Grid.Column="2" Width="130" Margin="8,0,0,0" Content="{DynamicResource Loc_OPEN_SPANSH}"
                        Click="OpenSpanshButton_Click"/>
                <TextBlock x:Name="NextRouteSystemLink" Grid.Column="3" Margin="12,0,4,0"
                           VerticalAlignment="Center" Style="{DynamicResource ClickableTextStyle}"
                           ToolTip="{DynamicResource Loc_CLICK_TO_COPY_SYSTEM}"
                           MouseLeftButtonUp="CopySystemText_MouseLeftButtonUp"/>
                <Button Grid.Column="4" Width="150" Margin="8,0,0,0" Content="{DynamicResource Loc_REFRESH_DATA}"
                        Click="RefreshExplorationCatalogButton_Click"/>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
