<Application x:Class="ED_Inara_Overlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ED_Inara_Overlay"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The default catalog is declared here so Visual Studio's XAML
                     designer and IntelliSense can resolve Loc_* resources. At
                     runtime LocalizationService replaces it with the language
                     selected in Settings. -->
                <ResourceDictionary Source="Resources/Localization.ru-RU.xaml"/>
                <ResourceDictionary Source="Resources/UIStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
