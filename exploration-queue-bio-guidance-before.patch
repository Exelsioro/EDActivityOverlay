+
+        if (active.Progress.HistoricalBiologyDetailIncomplete)
+        {
+            parts.Add(
+                Loc.Get(
+                    "Loc_EXPLORATION_HISTORY_BIO_DETAIL_INCOMPLETE"));
+        }
+
+        return string.Join(
