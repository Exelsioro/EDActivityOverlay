+    private static string BuildCompactRouteOrAlert(
+        GameStateSnapshot state,
+        ExplorationVisitQueueSnapshot? queue)
+    {
+        FuelRouteAssessment fuel =
+            FuelRouteAdvisor.Evaluate(state);
