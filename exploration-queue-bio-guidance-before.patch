+            return Loc.Format(
+                "Loc_EXPLORATION_ROUTE_NEXT_HUD_FORMAT",
+                next.System,
+                Math.Min(
+                    route.Stops.Count,
+                    route.CurrentIndex + 2),
+                route.Stops.Count);
+        }
+
+        if (queue is { DeferredCount: > 0 })
+        {
+            return Loc.Format(
+                "Loc_EXPLORATION_DEFERRED_HUD_FORMAT",
+                queue.DeferredCount);
+        }
+
+        return string.Empty;
+    }
